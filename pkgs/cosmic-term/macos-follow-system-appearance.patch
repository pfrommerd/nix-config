+                        let (tx, mut rx) = mpsc::unbounded_channel::<()>();
+
+                        // A distributed notification is delivered on the run loop of
+                        // the thread that registered the observer, so it must be the
+                        // main thread (the one winit drives). Register there via GCD;
+                        // the block forwards each change onto `tx`.
+                        dispatch2::DispatchQueue::main().exec_async(move || {
+                            use block2::RcBlock;
+                            use objc2_foundation::{
