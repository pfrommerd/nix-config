--- a/src/config.rs
+++ b/src/config.rs
@@ -37,11 +37,41 @@ impl AppTheme {
                 t.theme_type.prefer_dark(Some(false));
                 t
             }
+            // On macOS there is no cosmic-config, so `system_preference()` always
+            // reports dark. Resolve the real Aqua appearance instead and pin
+            // `prefer_dark` so libcosmic's ThemeMode watcher (which also reads the
+            // missing cosmic-config and would otherwise force dark) leaves it alone.
+            #[cfg(target_os = "macos")]
+            Self::System => {
+                let is_dark = macos_prefers_dark();
+                let mut t = if is_dark {
+                    theme::system_dark()
+                } else {
+                    theme::system_light()
+                };
+                t.theme_type.prefer_dark(Some(is_dark));
+                t
+            }
+            #[cfg(not(target_os = "macos"))]
             Self::System => theme::system_preference(),
         }
     }
 }
 
+/// Whether the macOS system appearance is currently set to Dark.
+///
+/// The global `AppleInterfaceStyle` default holds the string "Dark" in dark mode
+/// and is absent (the read fails) in light mode, so a successful read starting
+/// with "Dark" means dark and anything else means light.
+#[cfg(target_os = "macos")]
+pub fn macos_prefers_dark() -> bool {
+    std::process::Command::new("defaults")
+        .args(["read", "-g", "AppleInterfaceStyle"])
+        .output()
+        .map(|o| o.stdout.starts_with(b"Dark"))
+        .unwrap_or(false)
+}
+
