+# Used to follow the macOS system light/dark appearance: observe the
+# `AppleInterfaceThemeChangedNotification` distributed notification (registered on
+# the main run loop via GCD). These crates are already in the dependency tree via
+# winit on macOS, so no new vendored sources are pulled in.
+[target.'cfg(target_os = "macos")'.dependencies]
+objc2 = "0.6"
+objc2-foundation = { version = "0.3", default-features = false, features = [
+    "std",
+    "block2",
+    "NSString",
+    "NSNotification",
+    "NSDistributedNotificationCenter",
+    "NSOperation",
+] }
+block2 = "0.6"
+dispatch2 = "0.3"
+
 [build-dependencies]
 xdgen = "0.1"
 
